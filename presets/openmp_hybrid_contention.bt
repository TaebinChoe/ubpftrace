// ============================================================================
// UBPFTRACE PRESET: openmp_hybrid_contention.bt
// Scenario: Hybrid MPI+OpenMP Thread Synchronization & Lock Contention
//
// Diagnoses:
//  - Thread load imbalance during OpenMP parallel loop barrier synchronization.
//  - Critical section and mutex lock acquisition stalls.
//  - Execution time distribution of OpenMP parallel regions.
//
// Usage:
//  ubpftrace -c "srun -n 4 ./hybrid_app" presets/openmp_hybrid_contention.bt
// ============================================================================

uprobe:gomp:GOMP_barrier {
    @start_barrier[tid] = nsecs;
}

uretprobe:gomp:GOMP_barrier /@start_barrier[tid]/ {
    $dur_us = (nsecs - @start_barrier[tid]) / 1000;
    @omp_barrier_wait_us[tid] = hist($dur_us);
    @omp_barrier_stats_us[tid] = stats($dur_us);
    @total_barrier_stall_us[rank] = sum($dur_us);
    @barrier_events[tid] = count();

    delete(@start_barrier[tid]);
}

uprobe:gomp:GOMP_critical_start {
    @start_critical[tid] = nsecs;
}

uretprobe:gomp:GOMP_critical_start /@start_critical[tid]/ {
    $dur_us = (nsecs - @start_critical[tid]) / 1000;
    @critical_lock_wait_us[rank] = hist($dur_us);
    @critical_lock_stats_us[rank] = stats($dur_us);
    @critical_lock_calls[rank] = count();

    delete(@start_critical[tid]);
}

uprobe:gomp:GOMP_parallel {
    @start_parallel[tid] = nsecs;
}

uretprobe:gomp:GOMP_parallel /@start_parallel[tid]/ {
    $dur_us = (nsecs - @start_parallel[tid]) / 1000;
    @parallel_region_dur_us[rank] = hist($dur_us);
    @parallel_region_stats_us[rank] = stats($dur_us);
    @parallel_regions_count[rank] = count();

    delete(@start_parallel[tid]);
}

END {
    printf("\n============================================================\n");
    printf("         OPENMP HYBRID THREAD CONTENTION SUMMARY            \n");
    printf("============================================================\n");
}
