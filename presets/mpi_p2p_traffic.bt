// ============================================================================
// UBPFTRACE PRESET: mpi_p2p_traffic.bt
// Scenario: MPI Point-to-Point Message Sizing & Traffic Volume Matrix Profiler
//
// Diagnoses:
//  - Pairwise Rank-to-Rank communication traffic matrix (@traffic_matrix_bytes[src, dst]).
//  - Per-rank Transmission (Tx) and Reception (Rx) volume imbalances (Fan-in congestion).
//  - Message size distribution (Eager vs. Rendezvous protocol transitions).
//  - Ratio of blocking synchronous vs. non-blocking asynchronous transfers.
//
// Usage:
//  srun -N 2 -n 16 ubpftrace -c "examples/apps/mpi_p2p_app" presets/mpi_p2p_traffic.bt
// ============================================================================

uprobe:mpi:MPI_Send {
    $count = arg1;
    $dest = arg3;
    @traffic_matrix_bytes[rank, $dest] = sum($count);
    @traffic_matrix_msgs[rank, $dest] = count();
    @tx_bytes[rank] = sum($count);
    @msg_size_bytes["MPI_Send"] = hist($count);
    @p2p_calls["MPI_Send"] = count();
}

uprobe:mpi:MPI_Isend {
    $count = arg1;
    $dest = arg3;
    @traffic_matrix_bytes[rank, $dest] = sum($count);
    @traffic_matrix_msgs[rank, $dest] = count();
    @tx_bytes[rank] = sum($count);
    @msg_size_bytes["MPI_Isend"] = hist($count);
    @p2p_calls["MPI_Isend"] = count();
}

uprobe:mpi:MPI_Recv {
    $count = arg1;
    $src = arg3;
    @rx_matrix_bytes[rank, $src] = sum($count);
    @rx_bytes[rank] = sum($count);
    @msg_size_bytes["MPI_Recv"] = hist($count);
    @p2p_calls["MPI_Recv"] = count();
}

uprobe:mpi:MPI_Irecv {
    $count = arg1;
    $src = arg3;
    @rx_matrix_bytes[rank, $src] = sum($count);
    @rx_bytes[rank] = sum($count);
    @msg_size_bytes["MPI_Irecv"] = hist($count);
    @p2p_calls["MPI_Irecv"] = count();
}

uprobe:mpi:MPI_Sendrecv {
    $sendcount = arg1;
    $dest = arg3;
    @traffic_matrix_bytes[rank, $dest] = sum($sendcount);
    @tx_bytes[rank] = sum($sendcount);
    @msg_size_bytes["MPI_Sendrecv"] = hist($sendcount);
    @p2p_calls["MPI_Sendrecv"] = count();
}

END {
    printf("\n============================================================\n");
    printf("         MPI POINT-TO-POINT TRAFFIC MATRIX SUMMARY          \n");
    printf("============================================================\n");
}
