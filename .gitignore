# ==============================================================================
# ubpftrace .gitignore
# ==============================================================================

# --- Build Directories & Output Binaries ---
/build/
/build-*/
**/build/
**/build-*/
/bin/*
!/bin/.gitkeep

# Object, Static & Shared Library Artifacts
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.out
*.ll
*.bc
*.d

# --- CMake Output Files ---
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
/Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
CTestConfiguration.ini
*.cmake.in
!cmake/CmakeUninstall.cmake.in

# --- Generated Parser, Lexer & Source Headers ---
src/parser.tab.cc
src/parser.tab.hh
src/location.hh
src/position.hh
src/stack.hh
src/lex.yy.cc
src/resources/headers.cpp
src/resources/parser_resources.cpp

# --- Embedded Subsystem Artifacts ---
libbpf/src/*.a
libbpf/src/*.so
libbpf/src/*.so.*
libbpf/src/libbpf.pc
!libbpf/src/libbpf.pc.template
libbpf/src/sharedobjs/
libbpf/src/staticobjs/
bpftime/build/
bpftime/**/*.o
bpftime/**/*.so
bpftime/**/*.a

# --- IDE & Editor Files ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.#*
*.sublime-project
*.sublime-workspace
.DS_Store

# --- Tooling & Language Server Caches ---
.cache/
.clangd/
.ccls-cache/

# --- Logs & Test Runtime Temporaries ---
*.log
.vmtest.log
/dev/shm/bpftime_*

# --- Nix & Environment Artifacts ---
result
result-*
.direnv/

# --- Sample Application Binaries ---
examples/apps/alloc_app
examples/apps/calc
examples/apps/cuda_sync_app
examples/apps/hpc_app
examples/apps/lustre_io_app
examples/apps/math_app
examples/apps/mpi_p2p_app
examples/apps/nccl_collective_app
examples/apps/omp_app
examples/apps/puts_app
examples/apps/struct_app
examples/apps/libnccl.so
