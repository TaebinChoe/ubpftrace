// ============================================================================
// Getting Started - Scenario 1: Function Tracing & Arguments
//
// Description:
//  Attaches a uprobe to compute_task(), captures the execution timestamp (nsecs)
//  and function arguments (arg0=task_id, arg1=data_size), and streams formatted
//  events to standard output.
//
// Run:
//  ./bin/ubpftrace -c "./examples/getting_started/target_app 10" examples/getting_started/01_function_tracing.bt
// ============================================================================

uprobe:./examples/getting_started/target_app:compute_task {
    printf("[TS %lu ns] compute_task() invoked -> task_id=%d, data_size=%d bytes\n",
           nsecs, arg0, arg1);
}
