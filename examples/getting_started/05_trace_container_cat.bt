// ============================================================================
// Getting Started - Scenario 5: High-Speed Trace Container Recording (.ubpf)
//
// Description:
//  Emits events to the unpinned ring buffer. A dedicated background I/O worker
//  compresses chunks with LZ4 and writes them into high-speed .ubpf containers.
//  The container is decoded post-mortem using ubpftrace-cat (--info, --dump, --chrome).
//
// How to Run (Step-by-Step Prompts):
//  1. Record Traces to High-Speed .ubpf Container:
//     $ UBPFTRACE_OUTPUT_DIR=./examples/getting_started \
//       ./bin/ubpftrace -c "./examples/getting_started/target_app 10" \
//       examples/getting_started/05_trace_container_cat.bt
//
//  2. Inspect Container Metadata & LZ4 Compression Ratios:
//     $ ./bin/ubpftrace-cat --info examples/getting_started/*.ubpf
//
//  3. Dump Chronological Event Stream to Terminal:
//     $ ./bin/ubpftrace-cat --dump examples/getting_started/*.ubpf
//
//  4. Export to Perfetto / Chrome Tracing Timeline:
//     $ ./bin/ubpftrace-cat --chrome timeline.json examples/getting_started/*.ubpf
//
// Expected Step 1 Output (ubpftrace execution):
//  Attached 1 probe
//  [TargetApp] Starting execution of 10 tasks (~1.0 seconds)...
//  [TS 113086538302792 ns] Task 0 processed data_size=10 bytes
//  [TS 113086638374488 ns] Task 1 processed data_size=27 bytes
//  [TS 113086738434281 ns] Task 2 processed data_size=44 bytes
//  [TS 113086838493513 ns] Task 3 processed data_size=61 bytes
//  [TS 113086938548448 ns] Task 4 processed data_size=78 bytes
//  [TS 113087038608231 ns] Task 5 processed data_size=95 bytes
//  [TS 113087138666732 ns] Task 6 processed data_size=12 bytes
//  [TS 113087238724933 ns] Task 7 processed data_size=29 bytes
//  [TS 113087338798913 ns] Task 8 processed data_size=46 bytes
//  [TS 113087438877120 ns] Task 9 processed data_size=63 bytes
//  [TargetApp] Progress: 10 / 10 tasks (current task_id=9, data_size=63)
//  [TargetApp] Finished all tasks successfully.
//
// Expected Step 2 Output (ubpftrace-cat --info):
//  ============================================================
//    UBPFTRACE CONTAINER METADATA: ubpftrace_1014833_node_3650575891.ubpf
//  ============================================================
//    Job ID            : 1014833
//    Node ID           : 3650575891
//    Hostname          : login18
//    File Size         : 628 bytes (0.00 MB)
//    Codec             : LZ4
//    Base Monotonic Ts : 113086565071405 ns
//    Base Wallclock Ts : 1789708470377293701 ns
//    Total Chunks      : 1
//    Total Records     : 10
//    Total Dropped     : 0
//    Uncompressed Size : 840 bytes
//    Compressed Size   : 356 bytes (Savings: 57.6%)
//  ============================================================
//
// Expected Step 3 Output (ubpftrace-cat --dump):
//  [113086.565397s] [Node 3650575891] [Rank 0] [Event 1] [TS 113086538302792 ns] Task 0 processed data_size=10 bytes
//  [113086.639523s] [Node 3650575891] [Rank 0] [Event 1] [TS 113086638374488 ns] Task 1 processed data_size=27 bytes
//  [113086.739971s] [Node 3650575891] [Rank 0] [Event 1] [TS 113086738434281 ns] Task 2 processed data_size=44 bytes
//  [113086.840313s] [Node 3650575891] [Rank 0] [Event 1] [TS 113086838493513 ns] Task 3 processed data_size=61 bytes
//  [113086.939643s] [Node 3650575891] [Rank 0] [Event 1] [TS 113086938548448 ns] Task 4 processed data_size=78 bytes
// ============================================================================

uprobe:./examples/getting_started/target_app:compute_task {
    printf("[TS %lu ns] Task %d processed data_size=%d bytes\n",
           nsecs, arg0, arg1);
}
