// ============================================================================
// Getting Started - Scenario 5: High-Speed Trace Container Recording (.ubpf)
//
// Description:
//  Emits events to the unpinned ring buffer. A dedicated background I/O worker
//  compresses chunks with LZ4 and writes them into high-speed .ubpf containers.
//  The container is decoded post-mortem using ubpftrace-cat (--info, --dump, --chrome).
//
// Run:
//  UBPFTRACE_OUTPUT_DIR=./examples/getting_started ./bin/ubpftrace -c "./examples/getting_started/target_app 15" examples/getting_started/05_trace_container_cat.bt
//  ./bin/ubpftrace-cat --info examples/getting_started/*.ubpf
//  ./bin/ubpftrace-cat --dump examples/getting_started/*.ubpf
// ============================================================================

uprobe:./examples/getting_started/target_app:compute_task {
    printf("[TS %lu ns] Task %d processed data_size=%d bytes\n",
           nsecs, arg0, arg1);
}
